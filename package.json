{
  "name": "sparrow",
  "version": "1.0.0",
  "description": "小型图表库",
  "main": "lib/sparrow.js",
  "module": "esm/sparrow.mjs",
  "exports": {
    ".": {
      "import": "./esm/sparrow.mjs",
      "require": "./lib/sparrow.js"
    }
  },
  "browser": "dist/sparrow.js",
  "files": ["lib", "esm", "dist"],
  "author": "Buygig",
  "license": "MIT",
  "scripts": {
    "lint": "eslint src __tests__ examples scripts *.js --cache-location node_modules/.cache/eslint --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --coverage",
    "test:package": "node scripts/check-package.js",
    "test-live": "cross-env DEBUG_MODE=1 jest --runner jest-electron/runner --env jest-electron/environment --coverage",
    "build": "rimraf -rf ./dist ./lib ./esm && rollup --config",
    "ci": "run-s lint test build test:package",
    "prepack": "run-s build test:package",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.18.2",
    "@babel/preset-env": "^7.18.2",
    "@commitlint/cli": "^17.0.2",
    "@commitlint/config-conventional": "^17.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.17.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "husky": "^8.0.0",
    "jest": "^24.0.0",
    "jest-electron": "^0.1.12",
    "lint-staged": "^13.0.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "rollup": "^2.75.6",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-node-resolve": "^5.2.0"
  },
  "keywords": [],
  "lint-staged": {
    "*.js": "eslint --cache --fix"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
